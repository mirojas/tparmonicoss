// secrets.h.example — PLANTILLA de credenciales (esta SÍ se sube a git).
//
// Cómo usarla:
//   1. Copiá este archivo como include/secrets.h  (ese NO se sube: está en .gitignore)
//   2. Completá tus valores reales en secrets.h
//
// Así la clave del WiFi y la del OTA no quedan en el repositorio.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID      "tu-red-wifi"
#define WIFI_PASSWORD  "tu-clave-wifi"
#define OTA_HOSTNAME   "esp32-potencia"   // nombre del ESP32 en la red
#define OTA_PASSWORD   "clave-ota"        // clave que pide el upload por WiFi

#endif
